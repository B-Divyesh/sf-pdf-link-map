{
  "name": "pdf-link-map-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts && node site/scripts/build-sw.mjs",
    "build:cli": "cargo build --release -p pdf-link-map",
    "build": "npm run build:cli && npm run build:site",
    "test:site": "npm run build:site && node --test site/tests/site.test.mjs && node site/tests/browser.mjs",
    "test": "cargo test --workspace && npm run test:site"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
